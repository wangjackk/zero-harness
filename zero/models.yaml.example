# LLM 配置: models 下分 provider, 每个 provider 下直接分 model.
# model 传参格式: "<provider>/<model_name>", 如 "seed/glm-5.2".
#
# 使用: 复制本文件为 models.yaml (同目录).
# api_key 支持 $VAR / ${VAR} 环境变量引用 ---- 真实 key 放 zero/.env
# (复制 .env.example 填值; 也可直接写明文, 不以 $ 开头原样使用).

default: seed/glm-5.2

models:
  seed:
    api_key: $SEED_API_KEY
    base_url: https://ark.cn-beijing.volces.com/api/plan/v3
    glm-5.2:
      model: glm-5.2
      max_context: 1048576
      extra:
        reasoning: {effort: high}
        store: true
    doubao-turbo:
      model: doubao-seed-2.1-turbo
      max_context: 256000
      extra: {store: true}

  openrouter:
    api_key: $OPENROUTER_API_KEY
    base_url: https://openrouter.ai/api/v1
    claude-4.6:
      model: anthropic/claude-sonnet-4.6
      max_context: 200000
      extra: {}
