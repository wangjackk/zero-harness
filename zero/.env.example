# zero/.env -- 环境密钥模板 (复制为 zero/.env 填真实值; .env 已 gitignore)
# 加载: main.py 启动时读入; 终端已有的同名环境变量优先, 不被覆盖.
# models.yaml 的 api_key 以 $VAR 引用这里的值.

# Seed TTS (xml speak 说话, 火山引擎; 必填才出声, 缺省时文本回复正常但无语音)
SEED_TTS_API_KEY=
# 可选: 音色 (默认 zh_female_xiaohe_uranus_bigtts) / 模型版本 (默认 seed-tts-2.0)
#SEED_TTS_SPEAKER_ID=
#SEED_TTS_RESOURCE_ID=

# LLM provider keys (models.yaml 各 provider 的 api_key 引用)
SEED_API_KEY=
ALI_API_KEY=
ALI_TOKEN_API_KEY=
OPENROUTER_API_KEY=
